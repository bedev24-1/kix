# ---------------------------------------------------------------- base de données
# Supabase auto-hébergé : toutes les tables de Master Break vivent dans le schéma `mb`.
# Session pooler (port 6543) ou connexion directe (5432) — les deux fonctionnent,
# le driver est configuré avec prepare:false.
# Supabase auto-hébergé, depuis le même réseau Docker :
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@db:5432/postgres?options=-c%20search_path%3Dmb%2Cpublic"
DATABASE_POOL=10

# ⚠️ En production : 1. Sinon, au premier démarrage sur une base vide,
# l'application charge le jeu de démonstration (salles, comptes, jetons fictifs).
MB_SKIP_SEED=1

# Mot de passe des comptes du jeu de démonstration (développement uniquement).
# MB_DEMO_PASSWORD="masterbreak"

# Le premier administrateur : inscris-toi normalement, puis redémarre l'app.
# Le compte portant ce numéro passe administrateur au démarrage.
# MB_ADMIN_PHONE="677451208"

# --------------------------------------------------------------------- paiements
# pawaPay — Mobile Money (Orange Money, MTN MoMo).
# Paiements par buyfacturation (pay.buyticle.com) — prioritaire sur pawaPay en direct.
# La même clé doit figurer dans BUYFACT_APPS côté buyfacturation : « kix:<clé> ».
# BUYFACT_URL="https://pay.buyticle.com"
# BUYFACT_API_KEY=""
# Sans PAWAPAY_API_TOKEN, l'app utilise l'encaisseur de démonstration : même
# parcours, même écran d'attente, aucun argent qui bouge.
# PAWAPAY_API_TOKEN=""
# PAWAPAY_ENV="sandbox"            # sandbox | production
# PAWAPAY_CURRENCY="XAF"
# PAWAPAY_DIAL_CODE="237"
# PAWAPAY_PROVIDER_OM="ORANGE_CMR"
# PAWAPAY_PROVIDER_MOMO="MTN_MOMO_CMR"
# MB_PAYMENT_PROVIDER=""           # force "pawapay" ou "simulated"

# Callback de démonstration : sans ce secret, /api/webhooks/pawapay refuse tout
# en mode simulé. En mode pawaPay, le callback est revérifié auprès de leur API.
# MB_SIMULATED_WEBHOOK_SECRET=""
# MB_SIMULATED_DELAY_MS=4000       # délai avant confirmation, en mode simulé

# ----------------------------------------------------------- Master Break Live
# Serveur média MediaMTX (voir deploy/mediamtx.yml). Sans MB_MEDIA_URL, les
# directs se créent mais rien n'est diffusé.
# HLS et WebRTC sont deux serveurs sur deux ports : deux sous-domaines.
# MB_MEDIA_URL="https://media.example.com"      # diffusion HLS (proxy → :8888)
# MB_MEDIA_WHIP="https://whip.example.com"      # WebRTC WHIP/WHEP (proxy → :8889)
# MB_MEDIA_RTMP="rtmp://media.example.com:1935" # ingestion OBS / caméra
# MB_MEDIA_HOOK_SECRET=""                          # partagé avec mediamtx.service

# ------------------------------------------------------------------ Master Pass
# Clé de signature des QR. Absente, une clé éphémère est tirée au démarrage :
# les laissez-passer ne survivent alors pas à un redéploiement (90 s de vie).
# MB_QR_SECRET=""

# URL publique de l'app, pour les liens sortants.
# MB_PUBLIC_URL="https://mb.example.com"

# --- Notifications -----------------------------------------------------------
# Sans Firebase : une paire à nous. `npm run push:cles` les génère.
# La publique fait 87 caractères et commence par B, la privée 43.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@masterbreak.cm

# Avec Firebase : la configuration web (publique), la clé Web Push (publique),
# et le compte de service (SECRET — jamais de préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Le compte de service, au choix : deux champs recopiés du fichier .json…
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# …ou le JSON entier, collé tel quel ou encodé en base64.
FIREBASE_SERVICE_ACCOUNT=
