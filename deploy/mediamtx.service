# /etc/systemd/system/mediamtx.service
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now mediamtx
#
# Les deux variables sont lues par les crochets du fichier de configuration :
# MB_APP_URL doit pointer sur l'application, MB_MEDIA_HOOK_SECRET être le même
# secret que dans son environnement.

[Unit]
Description=MediaMTX — serveur média Master Break
After=network.target

[Service]
Environment=MB_APP_URL=https://masterbreak.vps.buyticle.com
Environment=MB_MEDIA_HOOK_SECRET=3c06a7f363ab76e13fc8f6ebdec6b2d84003d22c2451e0215b60e22e9e066ee5
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
Restart=always
RestartSec=3
User=mediamtx
Group=mediamtx
StateDirectory=mediamtx

[Install]
WantedBy=multi-user.target
